{
  "name": "plan-to-day",
  "version": "0.1.3",
  "description": "Plan long-term goals and daily tasks with lists, schedules, recurring tasks, and reviews",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:submission": "eslint main.ts src",
    "check": "npm run build && npm test && npm run lint:submission",
    "validate:release": "node scripts/validate-release.mjs",
    "release:check": "npm run check && npm run validate:release",
    "version": "node scripts/bump-version.mjs"
  },
  "keywords": [
    "obsidian",
    "todo",
    "task-management"
  ],
  "author": "Weitanaii",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "latest",
    "tslib": "2.7.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6"
  }
}
